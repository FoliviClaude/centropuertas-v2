# Copie ce fichier en "secrets.toml" (meme dossier) et renseigne tes
# vrais identifiants Turso -- "secrets.toml" est exclu de git (.gitignore),
# jamais "secrets.toml.example".
#
# TURSO_URL   : URL libsql://... de ta base Turso (dashboard Turso ou
#               "turso db show <nom>" si tu as la CLI).
# TURSO_AUTH_TOKEN : token genere pour cette base (dashboard Turso ou
#               "turso db tokens create <nom>").

TURSO_URL = "libsql://centropuertas-<ton-org>.turso.io"
TURSO_AUTH_TOKEN = "colle-ton-token-ici"
