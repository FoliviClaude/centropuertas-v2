{
  "permissions": {
    "allow": [
      "Bash(streamlit run app.py)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(black:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(pip install -r requirements.txt)",
      "Bash(pip install -r requirements-dev.txt)"
    ],
    "deny": [
      "Read(./.streamlit/secrets.toml)",
      "Read(./data/db/turso_token.txt)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import json,sys; d=json.load(sys.stdin); p=d.get('tool_input',{}).get('file_path','') or d.get('tool_response',{}).get('filePath',''); print(p)\" | { read -r f; f=\"${f%$'\\r'}\"; case \"$f\" in *.py) command -v ruff >/dev/null 2>&1 && ruff format \"$f\" ;; esac; } 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "ruff format"
          }
        ]
      }
    ]
  }
}
